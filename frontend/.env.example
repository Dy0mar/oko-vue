# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# Everything with the VITE_ prefix is bundled into the browser — only public values here.
# NEVER put the secret / service_role key here: it bypasses RLS.

# Local stack: `npx supabase status` → Project URL + Publishable key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
