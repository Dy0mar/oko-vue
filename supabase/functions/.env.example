# Local secrets for `supabase functions serve` / local edge runtime. Copy to supabase/functions/.env
# In the cloud: npx supabase secrets set NAME=value ...
# Only the providers you enable in /admin need their secrets.

# Metered Open Relay — https://www.metered.ca/tools/openrelay/
METERED_APP_NAME=
METERED_API_KEY=

# Turnix — https://turnix.io/
TURNIX_API_TOKEN=

# Cloudflare — Dashboard → Realtime → TURN → Create key
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
